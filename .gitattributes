# Normalize line endings: LF in the repository and in the working tree, on every OS.
# Without this, a Windows checkout shows the whole repository as modified, because the
# committed blobs are LF while the working tree is CRLF (core.autocrlf is unset).
# https://git-scm.com/docs/gitattributes#_end_of_line_conversion
* text=auto eol=lf

# Binary assets are never text-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
