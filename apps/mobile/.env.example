# Copy to apps/mobile/.env.local. Expo inlines EXPO_PUBLIC_* values into the app bundle,
# so never put secrets here.

# Phone on the same Wi-Fi as your laptop: use the laptop's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# Or the deployed API:
# EXPO_PUBLIC_API_URL=https://budgetsplit-api.onrender.com

# Dev-only identity (until US-01). Seeded ids: Maya 1111..., Josh 2222..., Priya 3333..., Sam 4444...
# EXPO_PUBLIC_DEV_USER_ID=22222222-2222-4222-8222-222222222222
