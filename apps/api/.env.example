# Copy to apps/api/.env for local development. Never commit .env.
DATABASE_URL=postgresql://budgetsplit:budgetsplit@localhost:5432/budgetsplit
# Integration tests wipe this database; its name must contain "test".
TEST_DATABASE_URL=postgresql://budgetsplit:budgetsplit@localhost:5432/budgetsplit_test
# AI summary (US-11). Optional: without a key the summary endpoint returns the numbers only.
# Get a key at https://console.anthropic.com and keep it out of git.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-5-5
# LLM_DAILY_CALL_LIMIT=500
PORT=4000
# "dev" trusts an X-User-Id header (local development and tests only; production refuses it).
# "firebase" verifies a Firebase ID token on every request and needs FIREBASE_PROJECT_ID (docs/auth-setup.md).
AUTH_MODE=dev
# FIREBASE_PROJECT_ID=your-project-id
# Requests one signed-in user may make per minute (default 120; 0 = no limit).
# RATE_LIMIT_PER_MINUTE=120
